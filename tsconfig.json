{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework"
    ],
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["./assets/*"],
      "@/*": [
        "./*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
}
